{
  "opencollection": "1.0.0",
  "info": {
    "name": "LeaseAccelerator Documents API",
    "version": "26.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add/Update Artifact with Line Items",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.leaseaccelerator.com/lease_accelerator/api/LeaseAccelerator/AddUpdateArtifact",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This method may be used to update existing documents, add new documents to an existing deal, or create a new deal from a new document. Note that, while this method can be used to add or update multiple artifacts at once, at least two invocations will be needed to create a new deal containing multiple documents. (The first invocation will assign the dealId for the new deal, which can then be used in the subsequent invocation(s).)\n\nOperation key: `AddUpdateArtifact`. Reference: https://docs-leasea"
        },
        {
          "info": {
            "name": "Attach File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.leaseaccelerator.com/lease_accelerator/api/LeaseAccelerator/AttachFile",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "filetoattach",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This method may be used to attach documents to a deal. This method is similar to the functionality when using the “Mainfest tab” on the PIW.\n\nOperation key: `AttachFile`. Reference: https://docs-leaseaccelerator.insightsoftware.com/hc/en-us/articles/33895853166093-API-Methods"
        },
        {
          "info": {
            "name": "Capture Posted Document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.leaseaccelerator.com/lease_accelerator/api/LeaseAccelerator/CaptureDocumentId",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This method is used to communicate accepted journal entries from the ERP back to LeaseAccelerator.\n\nOperation key: `CaptureDocumentId`. Reference: https://docs-leaseaccelerator.insightsoftware.com/hc/en-us/articles/33895853166093-API-Methods"
        },
        {
          "info": {
            "name": "Get Documents for Deal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.leaseaccelerator.com/lease_accelerator/api/LeaseAccelerator/GetDocumentsforDeal",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "The GetDocumentsforDeal operation. See the API Methods reference for the full request and response payload.\n\nOperation key: `GetDocumentsforDeal`. Reference: https://docs-leaseaccelerator.insightsoftware.com/hc/en-us/articles/33895853166093-API-Methods"
        }
      ]
    }
  ],
  "bundled": true
}